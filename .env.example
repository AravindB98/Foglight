# Copy to .env and fill in only what you need. Foglight runs without any of these.

# Enables LLM-written briefs. If unset, Foglight uses the offline extractive
# synthesizer.
ANTHROPIC_API_KEY=

# Optional: override the model used for briefs.
FOGLIGHT_LLM_MODEL=claude-haiku-4-5-20251001

# Memory backend: auto (supermemory -> vector -> SQLite) | supermemory | vector | sqlite
FOGLIGHT_MEMORY_BACKEND=auto

# --- Supermemory backend (optional) ---------------------------------------
# Set ONE of these to enable the Supermemory engine (fact extraction,
# auto-forgetting, hybrid RAG+memory, profiles). pip install supermemory
#   Hosted API:
SUPERMEMORY_API_KEY=
#   OR a local server (offline; `supermemory local` -> http://localhost:6767):
SUPERMEMORY_BASE_URL=

# --- Alerts (optional) ----------------------------------------------------
# Console alerts always work. Set either of the below to also push alerts
# when a watchlist surfaces a new, cross-platform-corroborated story.

# Slack incoming-webhook URL
FOGLIGHT_SLACK_WEBHOOK=

# Email (SMTP)
FOGLIGHT_SMTP_HOST=
FOGLIGHT_SMTP_PORT=587
FOGLIGHT_SMTP_USER=
FOGLIGHT_SMTP_PASS=
FOGLIGHT_SMTP_FROM=
FOGLIGHT_SMTP_TO=
